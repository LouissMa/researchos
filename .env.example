# ResearchOS configuration — copy to .env and edit. Everything has a safe default
# so the system runs offline with zero external services. Nothing here is required
# for the default (local) profile.

# ---- General ----
RESEARCHOS_DATA_DIR=./data
RESEARCHOS_LOG_LEVEL=INFO

# ---- Embeddings ----
# Provider: "local" (deterministic, offline, no downloads) | "openai" | "bge"
RESEARCHOS_EMBEDDING_PROVIDER=local
RESEARCHOS_EMBEDDING_DIM=384

# ---- LLM (optional) ----
# Provider: "null" (heuristic, no key needed) | "openai" (any OpenAI-compatible API)
RESEARCHOS_LLM_PROVIDER=null
# For an OpenAI-compatible endpoint (OpenAI, vLLM, Together, DeepSeek, Ollama, ...):
# RESEARCHOS_LLM_PROVIDER=openai
# RESEARCHOS_LLM_MODEL=gpt-4o-mini
# RESEARCHOS_LLM_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...

# ---- Vector store ----
# Mode: "embedded" (local Qdrant, no server) | "server"
RESEARCHOS_QDRANT_MODE=embedded
# RESEARCHOS_QDRANT_URL=http://localhost:6333

# ---- Ingestion ----
# Set true to download and parse PDF full text (requires: pip install researchos[pdf])
RESEARCHOS_FETCH_PDF=false
